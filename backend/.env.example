# Hardware configuration template. Keep the real ingestion key in .env only.
DATABASE_URL=sqlite:///./data/power.db
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=false
SEED_DEMO_HISTORY=false
TIMEZONE=Asia/Kolkata
# Required: a random secret of at least 16 characters.
# The ESP32 must send this same value as X-Ingest-Key to POST /api/readings.
INGEST_API_KEY=
# Supabase example (URL-encode password; use direct/session connection, not transaction pooler):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require
